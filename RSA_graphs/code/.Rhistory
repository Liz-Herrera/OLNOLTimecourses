early_plot_collapsed <- final_results_allROIs %>%
filter(leStage == "Early") %>%
mutate(
ROI_label = dplyr::recode(ROI, "Complex" = "RSComplex")
)
roi_colors_early <- c(
"Hippocampus" = "#E69F00",
"RSC"         = "#7B3294",
"RSComplex"   = "#0072B2"
)
# Add stars to display significant values
dodge_width <- 0.4
p2 <- ggplot(
early_plot_collapsed,
aes(
x     = Hall,
y     = mean_diff,
color = ROI_label,
group = ROI_label
)
) +
# Error bars
geom_errorbar(
aes(
ymin = mean_diff - se_diff,
ymax = mean_diff + se_diff
),
width = 0.15,
linewidth = 0.6,
color = "black",
position = position_dodge(width = dodge_width)
) +
# Points
geom_point(
size = 3.5,
position = position_dodge(width = dodge_width)
) +
# ✅ Significance stars (key addition)
geom_text(
aes(
label = sig_value,
y = mean_diff + se_diff + 0.003
),
position = position_dodge(width = dodge_width),
color = "black",
size = 6,
fontface = "bold"
) +
# Zero reference line
geom_hline(
yintercept = 0,
linetype = "dashed",
linewidth = 0.6,
color = "grey40"
) +
# Y axis
scale_y_continuous(
limits = c(-0.01, 0.08),
breaks = y_breaks,
labels = scales::number_format(accuracy = 0.01),
expand = c(0, 0)
) +
# X axis with 4 ticks
scale_x_discrete(
limits = c("Cue period", "1st hallway", "2nd hallway", "Goal")
) +
# Colors
scale_color_manual(
values = roi_colors_early,
name   = "ROI"
) +
labs(
x = "Hall",
y = "(OL New+New) − (OL New+Old)"
) +
theme_classic(base_size = 16) +
theme(
axis.text.x  = element_text(color = "black"),
axis.text.y  = element_text(color = "black"),
axis.title.y = element_text(face = "bold", size = 12),
axis.line    = element_line(linewidth = 0.8),
axis.ticks   = element_line(linewidth = 0.8)
)
# ✅ Required in R Markdown
print(p2)
ggsave(
"Early_Repulsion_ttests_EH_collapsedHall_withStars.tiff",
